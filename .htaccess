Options -Indexes
RewriteEngine On

# Protejează configurarea și fișierele de dezvoltare pe hostingul Apache/cPanel.
<FilesMatch "^(\.env(\..*)?|package(-lock)?\.json|server\.js)$">
  Require all denied
</FilesMatch>

RewriteCond %{REQUEST_URI} !/api/index\.php$
RewriteRule ^api/([a-zA-Z0-9/_-]+)$ api/index.php?route=$1 [QSA,L]
