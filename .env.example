# Copiați acest fișier în .env în directorul aplicației și completați valorile.
# Pentru MySQL cPanel, DB_HOST este de regulă localhost; folosiți numele complet
# al bazei și utilizatorului, inclusiv prefixul de cont cPanel.
DB_HOST=localhost
DB_NAME=CPANELUSER_fleetos
DB_USER=CPANELUSER_fleetosuser
DB_PASSWORD=parola_mysql

# Datele pentru autentificarea în aplicația FleetOS.
FLEETOS_LOGIN_USER=admin
FLEETOS_LOGIN_PASSWORD=alegeti_o_parola_lunga_si_unica

# Integrările opționale necesită adaptare la PHP înainte de activare.
OPENAI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
