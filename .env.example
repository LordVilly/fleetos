# Copiați acest fișier în .env în directorul aplicației și completați valorile.
# Pentru MySQL cPanel, DB_HOST este de regulă localhost; folosiți numele complet
# al bazei și utilizatorului, inclusiv prefixul de cont cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CPANELUSER_fleetos
DB_USER=CPANELUSER_fleetosuser
DB_PASSWORD="schimbati_cu_parola_mysql"

# Datele pentru autentificarea în aplicația FleetOS.
FLEETOS_LOGIN_USER=admin
FLEETOS_LOGIN_PASSWORD="schimbati_cu_o_parola_lunga_si_unica"

# Integrări opționale. Activați cURL și OpenSSL în selectorul PHP cPanel.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=vXX.X
# Opțional: șablon aprobat de WhatsApp pentru mesaje inițiate de firmă.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ro
